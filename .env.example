# Supabase server credentials (never expose service-role key in frontend)
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY

# Frontend-safe Supabase values (public anon/publishable key only)
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_
# Choose a long random secret. Keep in Vercel Environment Variables only.
ADMIN_API_KEY=replace-with-a-long-random-secret
SUPABASE_BUCKET=academic-pdfs

# Search plan
FREE_DAILY_SEARCH_LIMIT=10

# Razorpay Dashboard > Account & Settings > API Keys
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=YOUR_RAZORPAY_KEY_SECRET
RAZORPAY_WEBHOOK_SECRET=YOUR_RAZORPAY_WEBHOOK_SECRET

# Google AdSense: set these only after AdSense approves your site and provides ad slots.
VITE_ADSENSE_CLIENT=
VITE_ADSENSE_SLOT_TOP=
VITE_ADSENSE_SLOT_RESULTS=
